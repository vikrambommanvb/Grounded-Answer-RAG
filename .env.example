# Grounded Answer Configuration

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage
DATABASE_URL=sqlite:///data/sqlite.db
VECTOR_STORE_DIR=data/vector_store
POLICY_DOCS_DIR=docs/policy

# LLM Providers (default: mock for deterministic offline operation)
DEFAULT_PROVIDER=mock
# Set to 'groq', 'openai', 'gemini', 'ollama', or 'mock'

# Provider Credentials (leave blank when using mock)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend Environment Configuration (for Vercel or decoupled deployments)
# When set, the frontend calls this backend URL.
# When left unset or empty, the Vite dev server safely proxies /api to http://127.0.0.1:8000
VITE_API_BASE_URL=https://grounded-answer-rag.onrender.com

# Retrieval & Evaluation
RETRIEVAL_TOP_K=5
HYBRID_RETRIEVAL=true
SIMILARITY_THRESHOLD=0.20

